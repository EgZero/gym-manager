# --- Servidor ---------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ----------------------------------------------------
DATABASE_URL=postgresql://gymapp:devlocal@127.0.0.1:5432/gymdb
PGSSL=false

# --- Seguridad --------------------------------------------------------
