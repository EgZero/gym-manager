JWT_SECRET=cambie-este-secreto-en-produccion-min-32-caracteres
JWT_EXPIRES_IN=8h
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15

# --- Reglas de negocio ------------------------------------------------
PUNTOS_POR_ASISTENCIA=2
